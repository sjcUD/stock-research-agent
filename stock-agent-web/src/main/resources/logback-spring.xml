<configuration>
    <appender name="SAFE_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="io.github.sjcud.stockagent.web.operations.SensitiveDataLayout">
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n%ex</pattern>
            </layout>
        </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="SAFE_CONSOLE"/></root>
</configuration>
