# OpenAI 兼容 Embedding 服务；留空时 Web 应用使用本地内存模式，不创建真实模型 Bean。
STOCK_AGENT_EMBEDDING_API_KEY=
STOCK_AGENT_EMBEDDING_BASE_URL=https://api.openai.com
STOCK_AGENT_EMBEDDING_MODEL=text-embedding-3-small
STOCK_AGENT_EMBEDDING_DIMENSIONS=1536

# 启用后装配真实 Qdrant RAG 链路。
STOCK_AGENT_QDRANT_ENABLED=false
STOCK_AGENT_QDRANT_HOST=localhost
STOCK_AGENT_QDRANT_GRPC_PORT=6334
STOCK_AGENT_QDRANT_COLLECTION=stock_agent_documents
STOCK_AGENT_RAG_CHUNK_SIZE=800
